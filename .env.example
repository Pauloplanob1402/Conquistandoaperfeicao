# Copie para .env.local (uso local). Na Vercel, cadastre as variáveis em Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
NEXT_PUBLIC_SITE_URL=https://conquistandoaperfeicao.vercel.app

# Newsletter por e-mail (Brevo). Sem elas, "Publicar só na plataforma" continua funcionando.
BREVO_API_KEY=sua-chave-da-brevo
NEWSLETTER_REMETENTE_EMAIL=email-verificado-na-brevo@seudominio.com.br
NEWSLETTER_REMETENTE_NOME=Conquistando a Perfeição

# Só para o envio agendado (cron diário). Variável de servidor: NUNCA use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
CRON_SECRET=invente-uma-senha-longa-e-aleatoria
